[Unit]
Description=ATHENA Feishu personal agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=athena
Group=athena
EnvironmentFile=/etc/athena/athena.env
WorkingDirectory=/opt/athena/current
ExecStart=/opt/athena/current/.venv/bin/athena-feishu
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
MemoryHigh=700M
MemoryMax=1000M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/athena/data

[Install]
WantedBy=multi-user.target
