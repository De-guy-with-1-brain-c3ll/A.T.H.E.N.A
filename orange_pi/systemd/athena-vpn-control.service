[Unit]
Description=ATHENA narrow VPN control socket
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/athena/vpn_server.py
Restart=on-failure
RuntimeDirectory=athena-vpn
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
