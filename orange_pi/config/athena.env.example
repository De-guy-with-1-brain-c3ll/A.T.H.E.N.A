# Copy to /etc/athena/athena.env and keep it readable only by root and athena.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=

# Keep DeepSeek for memory/tools/text chat. Set these two voice-only options to
# use Qwen Turbo for the response that feeds TTS (tested fastest on this Pi).
ATHENA_VOICE_LLM_PROVIDER=deepseek
# ATHENA_VOICE_LLM_MODEL=qwen-turbo

# Persistent across signed releases.
ATHENA_DATA_DIR=/opt/athena/data
ATHENA_DATABASE_PATH=/opt/athena/data/athena.db

ATHENA_STT_MODEL=qwen-audio-3.0-asr-flash-streaming
ATHENA_TTS_MODEL=qwen3-tts-flash-realtime
ATHENA_WAKE_WORD=athena
# SenseVoice checks for the wake word locally. Qwen still transcribes accepted
# commands, follow-ups and approvals; unrelated room speech sends no cloud audio.
ATHENA_LOCAL_WAKE=1
ATHENA_KEYWORD_MODEL_DIR=/opt/athena/models/keyword
ATHENA_STT_LANGUAGE=en

# Speech recognition is billed per second of audio sent, not per token, so the
# levers are the model and how much audio reaches the service. Real-time options
# (China list price, CNY per audio second, 36,000s free for 90 days):
#   qwen-audio-3.0-asr-flash-streaming  0.00033  newest, multilingual, any rate
#   fun-asr-realtime                    0.00033  multilingual, AOQ for weak networks
#   fun-asr-flash-8k-realtime           0.00022  cheapest, Chinese only, 8 kHz
#
# The two English models are tied on measured word error rate, so choose on the
# other properties. "qwen3-asr-flash-realtime" is not listed: the service answers
# "Model not found" for it.
#
# Keep a recognition session warm between turns so the websocket handshake is
# paid during silence instead of after you start talking. 0 compares the old way.
ATHENA_STT_PREWARM=1
# Let DashScope finalise after the local gate closes the input. Live paced tests
# found an explicit threshold can delay final transcripts by seconds.
ATHENA_STT_MAX_SENTENCE_SILENCE_MS=750

# Recognition can also run on the board itself, which is the only way to stop
# being billed per audio second:
#   qwen         cloud recognition, billed per second of audio
#   sensevoice   local SenseVoice-Small, free and offline
# MEASURED ON THIS BOARD, not on a desktop: 1.1x realtime on two threads and
# 0.7x on four, with a ~12.5s model load at start-up. Accurate, but only just
# keeps pace while someone is speaking. Four threads was slower than two, so the
# decode is memory-bandwidth-bound. Free, not faster.
#
# IT ALSO COSTS CPU, WHICH THE CLOUD ONE DOES NOT. The recogniser re-decodes the
# whole turn's buffer every 0.8s to emit partials, so a turn the voice gate holds
# open grows a buffer that at 1.1x realtime can never be decoded in time.
# Measured at 326% CPU on this 4-core board, which starved everything else on it
# — a release build that normally takes 2m40s exceeded a 15-minute timeout. Idle
# it settles near 50%, so the trap is a gate that sticks on room noise, not the
# normal path. After enabling, check for `speech=yes` in the log and the process
# CPU; if the gate sticks, raise ATHENA_VAD_MINIMUM_RMS.
#
# TRIED AND SWITCHED BACK OFF (2026-09-19): at 1.1x realtime the partials arrive
# late and the final transcript lands after the pause a person reads as "it
# didn't hear me", which made conversation unusable. Accurate and free is not the
# same as fast enough. The model stays installed, so this is one value to
# re-enable on faster hardware or for offline use.
# Install the model with `sudo bash tools/download_sensevoice.sh`, which prints
# the settings below. If it is asked for but not usable, the cloud recogniser is
# used instead and the reason is printed, so a misconfiguration never leaves
# ATHENA deaf.
# ATHENA_STT_BACKEND=qwen
# ATHENA_SENSEVOICE_MODEL_DIR=/opt/athena/models/sensevoice
# int8 is 228 MB and about 2.5x faster; fp32 is 938 MB and slightly more
# accurate (word error rate 0.171 against 0.188). This board has no int8
# dot-product extensions, so the int8 advantage is much smaller than 2.5x here.
# ATHENA_SENSEVOICE_PRECISION=int8
# ATHENA_SENSEVOICE_THREADS=2

ATHENA_VAD_MINIMUM_RMS=400
ATHENA_VAD_NOISE_MULTIPLIER=2.7
# 600ms, not 260: a shorter window ended turns in the middle of a sentence.
ATHENA_VAD_END_SILENCE_MS=600

# Speech generation. The cloud voice bills per character; the others are free.
#
#   edge    Microsoft's neural voices, free, no account and no API key. Needs
#           `pip install edge-tts` and ffmpeg (already on this board) because Edge
#           returns MP3 and the speaker wants PCM.
#           Caveat: the Edge *browser's* protocol, reverse-engineered, not an
#           official API — Microsoft can break it without notice.
#   sherpa  local and free, runs in-process, sounds synthetic.
#   qwen    cloud voice, billed per character.
#
# MEASURED ON THIS BOARD:
#
#   edge, en-US-AriaNeural               0.84s to first audio, 9.6x realtime
#   vits-piper-en_US-libritts_r-medium   1.10x realtime   <- best local voice
#   vits-piper-en_US-lessac-medium       0.89x realtime
#   kitten-nano-en-v0_8-int8             0.30x realtime
#   kitten-nano-en-v0_8-fp32             0.46x realtime
#
# VOICE CHOICE, re-measured 2026-09-27 (time to first audio, same sentence):
#
#   en-US-AriaNeural      904ms   styles: Positive, Confident
#   en-US-JennyNeural     893ms   styles: Friendly, Considerate, Comfort
#   en-US-EmmaNeural     1240ms   styles: Cheerful, Clear, Conversational
#   en-US-AvaNeural      1334ms   styles: Expressive, Caring, Pleasant, Friendly
#
# Aria was the old default on speed alone, but carries no warmth at all — it
# reads flat, which is what made ATHENA sound cold. Jenny is equally fast and is
# tagged warm, so it costs nothing. Ava is the most expressive voice available
# and was the slowest measured, at roughly +430ms. Pick with that trade in mind.
#
# The desktop disagrees about the *ordering* of the local voices: there lessac is
# 26x and LibriTTS-R 13.8x, the opposite way round. Benchmark where it will speak.
#
# LibriTTS-R is 904 speakers, so it needs ATHENA_SHERPA_SPEAKER to pick a voice;
# 0 is only a default and is not a curated one. It is 78 MB against lessac's 63 MB.
#
# Two threads beats four on the local voices (1.10x against 0.66x), so extra
# threads only take cores from capture and playback.
# ATHENA_TTS_BACKEND=edge
# ATHENA_EDGE_VOICE=en-US-AvaNeural
# LEAVE THESE UNSET unless you want them: a no-op pitch measured 1.2-2.0s to first
# audio against 0.85s when nothing was sent. Rate is cheaper than pitch if you do
# want to change the delivery — `rate=+0%` measured 1271ms against 1334ms for Ava
# with no options at all, so an explicit rate is not the expensive part.
# ATHENA_EDGE_RATE=
# ATHENA_EDGE_PITCH=
# The speaker opens at this rate before anything is synthesized, so it must match
# what the backend produces. 24000 for Edge, and only change it for a proxy.
# ATHENA_EDGE_SAMPLE_RATE=24000
#
# VITS is also the same lessac-medium voice the Piper install already uses, just
# in sherpa's layout — so moving to the in-process backend costs nothing in voice
# quality and removes the subprocess entirely. Install it with
# `sudo bash tools/install_sherpa_tts.sh`, which prints the settings below.
# ATHENA_TTS_BACKEND=qwen
# ATHENA_SHERPA_MODEL_DIR=/opt/athena/models/sherpa
# ATHENA_SHERPA_MODEL=vits-piper-en_US-lessac-medium
# The family is detected from the directory name (vits/kitten/kokoro), so this
# is only needed for a directory named something else.
# ATHENA_SHERPA_FAMILY=
# ATHENA_SHERPA_PRECISION=int8
# Defaults per family — 22050 for VITS, 24000 otherwise — and the speaker is
# opened from it before the model loads, so a wrong value plays every reply at
# the wrong speed.
# ATHENA_SHERPA_SAMPLE_RATE=
# ATHENA_SHERPA_SPEAKER=0
# ATHENA_SHERPA_SPEED=1.0
# ATHENA_SHERPA_THREADS=2
# How long an unused voice stays loaded. 0 keeps it loaded forever, and is the
# default: retiring saves 75 MB but costs a 7.6 s reload on the next reply, and
# the first thing said after a pause is the one someone is standing there
# waiting for. This board has 2.7 GB free, so the memory is not the constraint.
# ATHENA_SHERPA_IDLE_SECONDS=0
# ATHENA_PIPER_VOICES=/opt/athena/voices
# ATHENA_PIPER_VOICE=en_US-lessac-medium
# Keep Piper warm for the service lifetime by default. Set a positive number only
# to reclaim memory after a quiet period.
# ATHENA_PIPER_IDLE_SECONDS=0
ATHENA_AUDIO_INPUT_DEVICE=default
ATHENA_AUDIO_OUTPUT_DEVICE=default
ATHENA_AUDIO_DEBUG=1

# Browser audio: keep ATHENA running here and let a device on the local network
# provide the microphone and speaker instead of the Pi's own ALSA devices. Start
# and stop it from the dashboard, which is local-network only and normally
# requires the dashboard password. No extra port is opened.
ATHENA_REMOTE_AUDIO=0

# Browser audio needs a browser "secure context". Without one the page is never
# given the microphone, and music fails with it because the speaker attaches over
# the same socket. Plain http on a local-network address is not a secure context
# (localhost would be, which is why this only bites when the dashboard is opened
# from another device), so the dashboard is served over HTTPS instead:
# "Use Dashboard HTTPS.cmd" does it, and orange_pi/pi/dashboard_tls.sh generates
# the certificate and fills in these two paths.
#
# The certificate is self-signed, so trust it once on every device that opens the
# dashboard -- a certificate the browser refuses is not a secure context either,
# so the microphone stays blocked until it is trusted.
#
# Half a pair, or a path that cannot be read, stops the dashboard at start-up
# rather than falling back to plain HTTP: a dashboard that looks healthy but
# cannot reach the microphone is harder to diagnose than one that refuses to run
# and says why.
# ATHENA_WEB_TLS_CERT=/etc/athena/tls/dashboard.crt
# ATHENA_WEB_TLS_KEY=/etc/athena/tls/dashboard.key

# What the microphone heard, and what happened to it. The voice service writes
# this file whenever the listening state changes and the dashboard reads it,
# which is what fills the "Detected speech" panel on the Command tab: the live
# transcript, whether the turn has closed, and how many frames of audio were
# retained from the onset of speech. It lives under /run (tmpfs), so writing it
# several times a second does not touch the SD card.
# ATHENA_AUDIO_STATUS_PATH=/run/athena/audio-status.json

# A short falling two-note blip played every time the end of speech is detected,
# so a turn closing is something you can hear rather than guess at. The
# acknowledgement chirp rises; this one falls, so the two cannot be confused.
# Set to 0 to turn it off.
# ATHENA_EOS_TONE=1

# The dashboard password can be switched off. It lives in /etc/athena/web.env
# with the rest of the dashboard credentials, and also works from here.
#
# Read this before switching it off. The dashboard is already restricted to
# private addresses, so this does not expose it to the internet — but on the
# local network it means anyone, including a guest or a compromised device, can
# read and rewrite the prompts, change every setting, and open the browser-audio
# bridge, which turns on the microphone and speaker in the room.
#
# What is NOT given up: the CSRF token. Writes still require a token derived from
# a signed session, so a page on some other website cannot silently drive the
# dashboard through the browser of whoever is sitting there. The password is the
# defence against someone else on the network; the CSRF token is the defence
# against a hostile page, and they are different problems.
#
# The value must be one of off/none/disabled/no/0. A typo, or an empty or missing
# password, leaves the password in force — failing towards "still protected" is
# the only safe direction for this to fail in.
# ATHENA_WEB_AUTH=off

ATHENA_TIMEZONE=Asia/Shanghai
ATHENA_TEAMS_POLL_MINUTES=15
ATHENA_TEAMS_ALERT_HOURS=24

# Microsoft Graph delegated read-only Teams access.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
ATHENA_TEAMS_SCOPES="User.Read Team.ReadBasic.All Channel.ReadBasic.All ChannelMessage.Read.All EduAssignments.Read"

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_OPEN_IDS=

PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
# Optional private-LAN PC inbox configured by tools/setup_pc_inbox.py.
ATHENA_PC_UPLOAD_URL=
ATHENA_PC_TRANSFER_KEY=
ATHENA_PC_VISION_MODEL=qwen-vl-plus
ATHENA_PC_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
