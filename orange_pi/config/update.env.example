# The Windows computer's LAN address. Replace 192.168.1.10.
ATHENA_UPDATE_URL=http://192.168.1.10:8765/

# Use the same random value in PowerShell when publishing. Minimum 32 characters.
ATHENA_UPDATE_KEY=

# Run only one interface at a time. Change to athena-voice.service for room voice.
ATHENA_UPDATE_SERVICE=athena-feishu.service
