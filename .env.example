DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=
# Voice replies may use the faster Qwen compatibility endpoint without changing
# DeepSeek-backed memory, tools, or text chat. Tested on the Orange Pi:
# qwen-turbo reached first text in about 0.44s.
ATHENA_VOICE_LLM_PROVIDER=deepseek
# ATHENA_VOICE_LLM_MODEL=qwen-turbo
ATHENA_DATA_DIR=data
ATHENA_DATABASE_PATH=data/athena.db
ATHENA_STT_MODEL=qwen-audio-3.0-asr-flash-streaming
ATHENA_TTS_MODEL=qwen3-tts-flash-realtime
ATHENA_WAKE_WORD=athena
ATHENA_STT_LANGUAGE=en

# Speech recognition is billed per second of audio sent, not per token, so the
# levers are the model and how much audio reaches the service. Real-time options
# (China list price, CNY per audio second, 36,000s free for 90 days):
#   qwen-audio-3.0-asr-flash-streaming  0.00033  newest, multilingual, any rate
#   fun-asr-realtime                    0.00033  multilingual, AOQ for weak networks
#   fun-asr-flash-8k-realtime           0.00022  cheapest, Chinese only, 8 kHz
#
# Measured 2026-09-17 against the live service: the two English models are tied
# on word error rate (0.114 vs 0.112 over six sentences), so the choice is not
# about accuracy. "qwen3-asr-flash-realtime" is deliberately absent — the service
# answers "Model not found" for it.
#
# Keep a recognition session warm between turns so the websocket handshake is
# paid during silence instead of after you start talking. 0 compares the old way.
ATHENA_STT_PREWARM=1
# Let DashScope finalise after the local gate closes the input. Live paced tests
# found an explicit threshold can delay final transcripts by seconds.
ATHENA_STT_MAX_SENTENCE_SILENCE_MS=750

# Recognition can also run entirely on this machine, which is the only way to
# stop being billed per audio second:
#   qwen         cloud recognition, billed per second of audio
#   sensevoice   local SenseVoice-Small, free and offline
# Local recognition needs the model and the sherpa-onnx runtime:
#           bash tools/download_sensevoice.sh
#           pip install sherpa-onnx
# If it is asked for but not usable, the cloud recogniser is used instead and
# the reason is printed, so a misconfiguration never leaves ATHENA deaf.
#
# MEASURED ON AN ORANGE PI ZERO 3, and this is the caveat that matters: local
# recognition costs CPU, and the cloud one costs none. SenseVoice runs at ~1.1x
# realtime there, and the recogniser re-decodes the whole turn's buffer every
# 0.8s to emit partials. A turn the voice gate holds open therefore grows a
# buffer that can never be decoded in time — measured at 326% CPU on a 4-core
# board, which starved everything else on it (a release build that normally took
# 2m40s exceeded a 15-minute timeout). It settles at ~50% CPU while the gate
# correctly reports silence, so the trap is a gate that sticks on noise, not the
# idle path. Watch `speech=yes` in the log and the process's CPU after enabling.
# ATHENA_STT_BACKEND=qwen
# ATHENA_SENSEVOICE_MODEL_DIR=outputs/models/sensevoice
# int8 is 228 MB and about 2.5x faster; fp32 is 938 MB and slightly more
# accurate (word error rate 0.171 against 0.188). On a CPU without int8
# dot-product extensions the int8 speed advantage largely disappears.
# ATHENA_SENSEVOICE_PRECISION=int8
# Two threads is 22-45x realtime on an x86 desktop but only ~1.1x on an Orange Pi
# Zero 3, so measure before assuming this machine has headroom. Four is *slower*
# there — the decode is memory-bandwidth-bound, so do not add threads.
# ATHENA_SENSEVOICE_THREADS=2

ATHENA_VAD_MINIMUM_RMS=400
ATHENA_VAD_NOISE_MULTIPLIER=2.7
# 600ms, not 260: a shorter window ended turns in the middle of a sentence.
ATHENA_VAD_END_SILENCE_MS=600

# Speech generation. The cloud voice bills per 10,000 characters (CNY 1, the same
# rate for every Qwen voice) and answers in about 0.6s.
#
#   edge    the best voice per unit of effort: Microsoft's neural voices, free,
#           no account and no API key. RECOMMENDED, and the default in practice
#           for anyone who wants speech that does not sound synthetic.
#           Needs `pip install edge-tts` and `ffmpeg` on PATH, because Edge
#           returns MP3 and the speaker wants PCM.
#           Caveat: this is the Edge *browser's* protocol, reverse-engineered, not
#           an official API. Microsoft can break it without notice, which is why
#           the fallbacks below exist.
#   sherpa  local and free, runs in-process. Sounds synthetic; see the table.
#   piper   the earlier local attempt, also free but shells out to a process.
#   qwen    cloud voice, billed per character, noticeably more natural
#
# MEASURED, because the family matters more than any other setting here. On an
# Orange Pi Zero 3 (NEON, but no int8 dot-product) at 2 threads:
#
#   edge, en-US-AriaNeural               0.84s to first audio, 9.6x realtime
#   vits-piper-en_US-libritts_r-medium   1.10x realtime  <- best local voice
#   vits-piper-en_US-lessac-medium       0.89x realtime
#   kitten-nano-en-v0_8-int8             0.30x realtime  <- 3x too slow there
#   kitten-nano-en-v0_8-fp32             0.46x realtime
#
# The desktop disagrees about the *ordering* of the local voices: there lessac is
# 26x and LibriTTS-R 13.8x, the opposite way round. A quantised model loses far
# more than its size suggests when the CPU has no int8 acceleration, so benchmark
# on the machine that will actually speak.
# ATHENA_TTS_BACKEND=edge
# Which Edge voice. Aria measured fastest to first audio; run
# `edge-tts --list-voices` for the several hundred others, across many languages.
# ATHENA_EDGE_VOICE=en-US-AvaNeural
# Prosody, as Edge spells it ('+10%', '-5%', '+5Hz'). LEAVE THESE UNSET unless you
# want them: sending a no-op pitch measured 1.2-2.0s to first audio against 0.85s
# when nothing was sent, so an unnecessary value costs 2.3 seconds per reply.
# ATHENA_EDGE_RATE=
# ATHENA_EDGE_PITCH=
# ATHENA_EDGE_SAMPLE_RATE=24000
# ATHENA_SHERPA_MODEL_DIR=/opt/athena/models/sherpa
# ATHENA_SHERPA_MODEL=vits-piper-en_US-lessac-medium
# Only needed for a directory whose name does not identify the family, since
# vits/kitten/kokoro are detected from it. One of: vits, kitten, kokoro, matcha.
# ATHENA_SHERPA_FAMILY=
# int8 or fp32, and it only applies to Kitten, which ships both.
# ATHENA_SHERPA_PRECISION=int8
# The speaker is opened at this rate before the model loads, so it must be right
# in advance. It defaults per family (22050 for VITS, 24000 otherwise); change it
# only for an unusual model, or every reply plays at the wrong speed.
# ATHENA_SHERPA_SAMPLE_RATE=
# Which voice, in a multi-speaker model. LibriTTS-R has 904 and Kitten has 8;
# single-speaker voices ignore it. 1.0 is the model's own speaking pace.
# ATHENA_SHERPA_SPEAKER=0
# ATHENA_SHERPA_SPEED=1.0
# Two threads is the default and four is worse on this board (0.66x against
# 0.89x), so extra threads cost cores that capture and playback want.
# ATHENA_SHERPA_THREADS=2
# How long an unused model stays loaded. 0 keeps it loaded forever, and is the
# default: retiring saves 75 MB but costs a 7.6 s reload on the next reply, which
# is the wrong trade when the first thing said after a pause is the one someone
# is waiting for. Set a positive number of seconds to retire anyway.
# ATHENA_SHERPA_IDLE_SECONDS=0
# ATHENA_PIPER_BINARY=piper
# ATHENA_PIPER_VOICES=~/.local/share/piper-voices
# ATHENA_PIPER_VOICE=en_US-lessac-medium
# The voice is reused between replies, so its load is paid once, in the background
# at start-up. The default is 0, which keeps it forever; use a positive number only
# if reclaiming memory matters more than a fast first reply after a pause.
# ATHENA_PIPER_IDLE_SECONDS=0
# ATHENA_TTS_MAX_CHARS=0
ATHENA_AUDIO_INPUT_DEVICE=
ATHENA_AUDIO_OUTPUT_DEVICE=
# Browser audio: run ATHENA here and hand its microphone and speaker to a
# device on the same local network. Start and stop it from the dashboard.
ATHENA_REMOTE_AUDIO=0

# The dashboard password can be switched off, as a deliberate opt-in. Read this
# before doing it: the dashboard is already restricted to private addresses, so
# this does not expose it to the internet, but on the local network it means
# anyone — a guest, a smart TV, a compromised device — can read and rewrite the
# prompts, change every setting, and open the browser-audio bridge, which turns
# on the microphone and speaker in the room.
#
# What is not given up is the CSRF token: writes still need a token derived from
# a signed session, so a page on another website cannot silently drive the
# dashboard through whoever's browser is open. The password defends against
# someone else on the network; CSRF defends against a hostile page.
#
# One of off/none/disabled/no/0. A typo, or an empty or missing password, leaves
# the password in force — failing towards "still protected" is the only safe
# direction here. The password itself lives in the project .env or, on a Pi, in
# /etc/athena/web.env with ATHENA_WEB_SECRET.
# ATHENA_WEB_AUTH=off

ATHENA_AUDIO_DEBUG=0
ATHENA_TIMEZONE=Asia/Shanghai
ATHENA_TEAMS_POLL_MINUTES=15
ATHENA_TEAMS_ALERT_HOURS=24
# Optional private-LAN PC inbox; generate a separate key, never an API key.
ATHENA_PC_UPLOAD_URL=
ATHENA_PC_TRANSFER_KEY=
ATHENA_PC_VISION_MODEL=qwen-vl-plus
ATHENA_PC_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_OPEN_IDS=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
# Optional space-separated delegated Graph scopes; these are read-only defaults.
ATHENA_TEAMS_SCOPES=User.Read Team.ReadBasic.All Channel.ReadBasic.All ChannelMessage.Read.All EduAssignments.Read
